{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXO 3D",
  "version": "0.1.0-alpha.2",
  "identifier": "com.nexo3d.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "NEXO 3D · Alpha",
        "width": 1500,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}

